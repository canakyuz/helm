{
  "name": "helm-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "ios:codegen": "bash ./scripts/ios-codegen.sh",
    "prebuild:ios": "node ./plugins/patch-extension-storage-file.js && expo prebuild -p ios --clean && node ./plugins/sync-ios-app-group-entitlements.js && node ./plugins/patch-ios-app-groups-build.js && node ./plugins/patch-ios-widget-scheme.js && node ./plugins/fix-cocoapods-modulemaps.js",
    "ios:verify-widget": "bash ./scripts/verify-widget-embedded.sh",
    "widget:preview": "open targets/widget/preview.html",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --project-id $HELM_SUPABASE_PROJECT_ID --schema public > src/types/database.ts",
    "gen:design": "bun ./scripts/gen-design-tokens.mjs",
    "build:ios": "make ios-local-build",
    "submit:ios": "make ios-submit",
    "release:ios": "make ios-local-release",
    "update:preview": "eas update --branch preview",
    "postinstall": "install-skia && node ./plugins/patch-extension-storage-file.js && node ./plugins/fix-cocoapods-modulemaps.js",
    "pod:fix": "node ./plugins/fix-cocoapods-modulemaps.js",
    "patch:ios-app-groups": "node ./plugins/patch-ios-app-groups-build.js",
    "patch:widget-storage": "node ./plugins/patch-extension-storage-file.js",
    "test": "bun test"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.2",
    "@expo/config-plugins": "~57.0.0",
    "@expo/ui": "~57.0.18",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@helm/api": "workspace:*",
    "@helm/config": "workspace:*",
    "@helm/design": "workspace:*",
    "@helm/domain": "workspace:*",
    "@helm/queries": "workspace:*",
    "@helm/types": "workspace:*",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "burnt": "^0.13.0",
    "expo": "^57.0.22",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-maps": "~57.0.3",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "helm-app-group": "file:./modules/helm-app-group",
    "lucide-react-native": "^1.16.0",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.0",
    "victory-native": "^41.20.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
