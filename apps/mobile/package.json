{
  "name": "helm-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:codegen": "bash ./scripts/ios-codegen.sh",
    "prebuild:ios": "node ./plugins/patch-extension-storage-file.js && expo prebuild -p ios --clean && node ./plugins/sync-ios-app-group-entitlements.js && node ./plugins/patch-ios-app-groups-build.js && node ./plugins/patch-ios-widget-scheme.js && node ./plugins/fix-cocoapods-modulemaps.js",
    "ios:verify-widget": "bash ./scripts/verify-widget-embedded.sh",
    "widget:preview": "open targets/widget/preview.html",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --project-id $HELM_SUPABASE_PROJECT_ID --schema public > src/types/database.ts",
    "build:preview": "eas build -p ios --profile preview",
    "submit:preview": "eas submit -p ios --latest",
    "update:preview": "eas update --branch preview",
    "postinstall": "install-skia && node ./plugins/patch-extension-storage-file.js && node ./plugins/fix-cocoapods-modulemaps.js",
    "pod:fix": "node ./plugins/fix-cocoapods-modulemaps.js",
    "patch:ios-app-groups": "node ./plugins/patch-ios-app-groups-build.js",
    "patch:widget-storage": "node ./plugins/patch-extension-storage-file.js"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "burnt": "^0.13.0",
    "helm-app-group": "file:./modules/helm-app-group",
    "expo": "^56.0.4",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.15",
    "expo-font": "^56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-linking": "~56.0.11",
    "expo-notifications": "~56.0.13",
    "expo-router": "~56.2.6",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.16",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.1.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "^0.8.3",
    "tailwindcss": "^3.4.0",
    "victory-native": "^41.20.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "typescript": "~6.0.3"
  }
}
