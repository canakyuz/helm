# Kopyala: cp .env.example .env - .env gitignored.
# Buraya SADECE mobil uygulamanın okuduğu değişkenler girer.
# EXPO_PUBLIC_* prefix'i client bundle'a gömülür → sır koyma.
# service_role key / DB şifresi BURAYA YAZILMAZ (bkz. CLAUDE.md §12).

EXPO_PUBLIC_HELM_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_HELM_SUPABASE_ANON_KEY=<supabase-anon-key>

# Opsiyonel: app.config.ts içindeki varsayılanı ezer (EAS Apple team)
# EXPO_APPLE_TEAM_ID=<apple-team-id>
