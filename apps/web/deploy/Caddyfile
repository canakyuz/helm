# helm.wesan.co — statik SPA + otomatik TLS + tek-kullanıcı auth duvarı.
# Caddy 2.8+ : `basic_auth`. Daha eski Caddy'de `basicauth` yaz.
# Şifre hash'i:  caddy hash-password   (bcrypt) → aşağıdaki <BCRYPT_HASH>'e koy.

helm.wesan.co {
	root * /var/www/helm/dist
	encode gzip zstd

	# Auth duvarı — RLS permissive (tek kullanıcı), uygulamayı public'e açma.
	basic_auth {
		can <BCRYPT_HASH>
	}

	# SPA fallback — Refine route'ları index.html'e düşer.
	try_files {path} /index.html
	file_server

	# Statik asset'ler uzun cache (içerik-hash'li dosya adları).
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
